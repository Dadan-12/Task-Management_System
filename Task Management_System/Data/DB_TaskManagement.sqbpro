    Id          INTEGER PRIMARY KEY AUTOINCREMENT, -- Use INT IDENTITY(1,1) PRIMARY KEY in SQL Server
    Title       VARCHAR(150) NOT NULL,
    StartTime   DATETIME NOT NULL,
    EndTime     DATETIME NOT NULL,
    Section     VARCHAR(50) NOT NULL
);</sql><sql name="SQL 2*">CREATE TABLE ClassSchedule (
    Id          INTEGER PRIMARY KEY AUTOINCREMENT, -- Use INT IDENTITY(1,1) PRIMARY KEY for SQL Server
    Title       VARCHAR(150) NOT NULL,             -- Name of the Class / Subject
    StartTime   DATETIME NOT NULL,
    EndTime     DATETIME NOT NULL,
    Section     VARCHAR(50) NOT NULL               -- &quot;NEUMANN&quot; or &quot;AIKEN&quot;
);</sql><current_tab id="1"/></tab_sql></sqlb_project>
